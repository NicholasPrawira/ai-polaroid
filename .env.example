# Required. Server-only — never exposed to the client.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to x-ai/grok-imagine-image-quality.
# Alternatives: google/gemini-3.1-flash-lite-image, google/gemini-3.1-flash-image,
#               google/gemini-3-pro-image, openai/gpt-5.4-image-2
# Full list: https://openrouter.ai/api/v1/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=

# Required. Supabase project — Settings › API.
# Both are safe in the browser: the anon key only ever acts as the signed-in
# user, and every table is behind row level security. There is deliberately no
# service role key here — nothing in this app needs to bypass RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
