# Required. Both are safe to expose to the browser — the publishable key is
# restricted by Row Level Security, not by secrecy. Find them at
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, but set it in production. Used to build the links in confirmation
# and password-reset emails; defaults to http://localhost:3000 for dev.
NEXT_PUBLIC_SITE_URL=

# Note: developing happens entirely on-device (canvas + LUT), so there is no
# AI provider key. OPENROUTER_API_KEY / OPENROUTER_IMAGE_MODEL used to live
# here and are no longer read by any code — if you still have one set, revoke
# it at the provider rather than leaving a live credential lying around.
